[Unit]
Description=Presensi Karyawan
After=network.target

[Service]
Type=simple
User=presensi
WorkingDirectory=/opt/presensi/app
Environment=PORT=3000
Environment=DATA_DIR=/opt/presensi/app/data
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
